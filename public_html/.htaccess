<IfModule mod_rewrite.c>
  RewriteEngine On
  # Single front controller (keep query strings)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve the PHP core, config, uploads source or SQL over HTTP.
<FilesMatch "^(config\.php|config\.example\.php)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/app/.*
RedirectMatch 404 ^/.*\.sql$
