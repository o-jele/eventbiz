    "fieldname": "custom_business_unit",
    "label": "Business Unit",
    "fieldtype": "Select",
    "options": "Creations\nDelights\nShared",
    "insert_after": "item_group"
  },
  {
    "doctype": "Custom Field",
    "dt": "Item",
    "fieldname": "custom_featured",
    "label": "Featured on Website",
    "fieldtype": "Check",
    "insert_after": "custom_business_unit"
  },
  {
    "doctype": "Custom Field",
    "dt": "Item",
    "fieldname": "custom_replacement_rate",
    "label": "Replacement Rate (missing-item charge)",
