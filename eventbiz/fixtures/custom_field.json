    "reqd": 1,
    "insert_after": "mobile_no"
  },
  {
    "doctype": "Custom Field",
    "dt": "Customer",
    "fieldname": "custom_whatsapp",
    "label": "WhatsApp",
    "fieldtype": "Data",
    "insert_after": "custom_primary_phone"
  },
  {
    "doctype": "Custom Field",
    "dt": "Sales Order",
    "fieldname": "custom_fulfilment_method",
    "label": "Fulfilment Method",
    "fieldtype": "Select",
    "options": "Customer Pickup\nDelivery",
    "insert_after": "delivery_date"
