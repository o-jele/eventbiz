{
  "doctype": "DocType",
  "name": "Customer Payment Declaration",
  "module": "Eventbiz",
  "custom": 0,
  "istable": 0,
  "issubmittable": 1,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "company",
    "customer",
    "amount",
    "payment_method",
    "payment_reference",
    "payment_date",
    "proof_attachment",
    "status",
    "payment_entry"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Company"
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "Customer"
    },
    {
      "fieldname": "amount",
      "label": "Amount",
      "fieldtype": "Currency",
      "reqd": 1
    },
    {
      "fieldname": "payment_method",
      "label": "Method",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Cash\nBank Transfer\nMobile Money\nOther Manual"
    },
    {
      "fieldname": "payment_reference",
      "label": "Payer Reference",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "payment_date",
      "label": "Payment Date",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "proof_attachment",
      "label": "Proof",
      "fieldtype": "Attach Image",
      "reqd": 0
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "Submitted\nPending Verification\nApproved\nRejected"
    },
    {
      "fieldname": "payment_entry",
      "label": "Payment Entry",
      "fieldtype": "Link",
      "reqd": 0,
      "options": "Payment Entry"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}